# URL absolue du backend Laravel.
#
# En dev : Expo Go ne peut pas atteindre 127.0.0.1 (qui pointe le téléphone).
# Trouve l'IP de ta machine sur le Wi-Fi (ipconfig → "Adresse IPv4")
# puis utilise-la ici. Exemple : http://192.168.1.42:8000/api
#
# IMPORTANT : Laravel doit écouter sur 0.0.0.0 (pas 127.0.0.1) :
#   php artisan serve --host=0.0.0.0 --port=8000
#
# En prod : l'URL Railway de production (voir docs/DEPLOY.md).
EXPO_PUBLIC_API_URL=http://192.168.1.42:8000/api
