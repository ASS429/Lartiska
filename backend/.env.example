APP_NAME=Lartiska
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Africa/Dakar
APP_URL=http://localhost:8000

APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file
PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ─────────────────────────────────────────────
# DATABASE
# Default: SQLite (zéro setup, parfait pour démarrer en local)
# Pour passer en MySQL : décommenter les lignes ci-dessous
# et créer la base : CREATE DATABASE lartiska;
# ─────────────────────────────────────────────
DB_CONNECTION=sqlite
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=lartiska
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ─────────────────────────────────────────────
# MAIL — log par défaut en local (les mails s'écrivent dans storage/logs/laravel.log)
# En production : Resend SMTP (3 000 emails/mois gratuits)
#   - Créer un compte sur resend.com → API Keys → noter la clé
#   - MAIL_MAILER=smtp / MAIL_HOST=smtp.resend.com / MAIL_PORT=465
#   - MAIL_USERNAME=resend / MAIL_PASSWORD=<API_KEY> / MAIL_ENCRYPTION=tls
# ─────────────────────────────────────────────
MAIL_MAILER=log
MAIL_HOST=smtp.resend.com
MAIL_PORT=465
MAIL_USERNAME=resend
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="contact@lartiska.com"
MAIL_FROM_NAME="${APP_NAME}"
# Notification admin pour les nouveaux devis (généralement l'email de Tounkara)
MAIL_ADMIN_NOTIFY=tounkara@lartiska.com

# ─────────────────────────────────────────────
# SANCTUM — domaines autorisés à recevoir des cookies CSRF (SPA)
# ─────────────────────────────────────────────
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:5173,127.0.0.1,127.0.0.1:5173

# ─────────────────────────────────────────────
# CORS — origines autorisées pour l'API (allow-list stricte)
# FRONTEND_URL : URL principale du front (utilisée aussi pour les liens emails)
# FRONTEND_EXTRA_ORIGINS : CSV d'autres origines autorisées (preview Render, staging…)
# ─────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
FRONTEND_EXTRA_ORIGINS=

# ─────────────────────────────────────────────
# INTÉGRATIONS RÉSEAUX SOCIAUX (à remplir plus tard)
# ─────────────────────────────────────────────
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v21.0
INSTAGRAM_BUSINESS_ID=

WHATSAPP_PHONE_NUMBER=221785446363
WHATSAPP_BUSINESS_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=

# ─────────────────────────────────────────────
# ADMIN — compte initial créé par UserSeeder
# En production, OBLIGATOIRE de définir ADMIN_DEFAULT_PASSWORD (fort).
# Si absent en prod, un mot de passe aléatoire est généré et affiché 1 fois.
# ─────────────────────────────────────────────
ADMIN_DEFAULT_EMAIL=tounkara@lartiska.com
ADMIN_DEFAULT_NAME=Tounkara
ADMIN_DEFAULT_PHONE=+221785446363
ADMIN_DEFAULT_PASSWORD=lartiska2026

# ─────────────────────────────────────────────
# UPLOADS / STORAGE
# Local : FILESYSTEM_DISK=public (par défaut, écrit dans storage/app/public)
# Production R2 : FILESYSTEM_DISK=r2 + remplir les R2_* ci-dessous
# ─────────────────────────────────────────────
MAX_UPLOAD_SIZE_MB=10

# Disque pour fichiers PRIVÉS (PDFs devis + pièces jointes clients).
# CRITIQUE en production : doit survivre aux redéploiements.
# 'local' = ok en dev, perte de données sur Railway. 'r2' en prod.
FILESYSTEM_DISK_PRIVATE=local

# ─────────────────────────────────────────────
# CLOUDFLARE R2 (compatible S3, sans egress fee)
# Dashboard Cloudflare → R2 → Manage R2 API Tokens
# Endpoint format: https://<account_id>.r2.cloudflarestorage.com
# Public URL : activer "Public access" sur le bucket pour obtenir
#              https://pub-<hash>.r2.dev, ou brancher un domaine custom
# ─────────────────────────────────────────────
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=lartiska-media
R2_REGION=auto
R2_ENDPOINT=
R2_PUBLIC_URL=

VITE_APP_NAME="${APP_NAME}"
